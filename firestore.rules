rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // ============================================
    // ADMINS COLLECTION
    // ============================================
    match /admins/{adminId} {
      // Only admins can read admins collection (for checking admin status)
      allow read: if request.auth != null && isAdmin();
      // Only admins can write to admins collection
      allow write: if isAdmin();
    }
    
    // ============================================
    // ADMIN ACTIONS COLLECTION
    // ============================================
    match /adminActions/{actionId} {
      // Only admins can read admin actions
      allow read: if isAdmin();
      // Only admins can create admin actions
      allow create: if isAdmin();
      // Only admins can update/delete admin actions
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Authenticated users can read any user's profile (needed for chat, search, profiles)
      allow read: if request.auth != null;
      
      // Users can create their own profile
      // BUT cannot set coin fields OR isActive field (admin-only)
      // Users can only set isActive to false or leave it undefined
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['uCoins', 'coins', 'cCoins'])
        && (!('isActive' in request.resource.data) 
             || request.resource.data.isActive == false);
      
      // Users can update their own profile
      // BUT cannot update isActive field (admin-only)
      // Allow uCoins updates for call deductions (decrements only - FieldValue.increment with negative value)
      // Users can update followersCount on any user's profile (for follow/unfollow)
      // Admins can update any user's profile including coin fields and isActive
      allow update: if (request.auth != null && request.auth.uid == userId
        // Prevent users from updating their own isActive field (admin-only)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'cCoins'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['uCoins']) 
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'cCoins'])
                && request.resource.data.uCoins is int
                && resource.data.uCoins is int
                && request.resource.data.uCoins < resource.data.uCoins))) // Allow uCoins decrement for calls
        || (request.auth != null 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
        || isAdmin(); // Admins can update everything including isActive
      
      // Users cannot delete their own profile (only admins can)
      allow delete: if isAdmin();
      
      // ============================================
      // TRANSACTIONS SUBCOLLECTION
      // ============================================
      match /transactions/{transactionId} {
        // Admins can read all transactions (for admin panel)
        // Users can read their own transactions
        allow read: if isAdmin() 
          || (request.auth != null && request.auth.uid == userId);
        
        // Users CANNOT create/update/delete transactions
        // Only Cloud Functions and server can create transactions
        // Admins can create/update/delete for admin panel
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      
      // ============================================
      // COIN TRANSACTIONS SUBCOLLECTION
      // ============================================
      match /coinTransactions/{transactionId} {
        // Admins can read all coin transactions (for admin panel)
        // Users can read their own coin transactions
        allow read: if isAdmin() 
          || (request.auth != null && request.auth.uid == userId);
        
        // Users CANNOT create/update/delete coin transactions
        // Only Cloud Functions can create coin transactions (for payment purchases)
        // Admins can create/update/delete for admin panel
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      
      // ============================================
      // FOLLOWING SUBCOLLECTION (users/{userId}/following/{targetUserId})
      // ============================================
      match /following/{targetUserId} {
        // Users can read any user's following list (public)
        allow read: if request.auth != null;
        
        // Users can create/delete in their own following collection
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        
        // Messages cannot be updated
        allow update: if false;
      }
      
      // ============================================
      // FOLLOWERS SUBCOLLECTION (users/{userId}/followers/{followerId})
      // ============================================
      match /followers/{followerId} {
        // Users can read any user's followers list (public)
        allow read: if request.auth != null;
        
        // Users can create/delete in their own followers collection
        // (when someone follows/unfollows them)
        allow create, delete: if request.auth != null && request.auth.uid == followerId;
        
        // Messages cannot be updated
        allow update: if false;
      }
      
      // ============================================
      // SEEN ANNOUNCEMENTS SUBCOLLECTION
      // ============================================
      match /seenAnnouncements/{announcementId} {
        // Users can read/write their own seen announcements
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // ============================================
      // DISMISSED ANNOUNCEMENTS SUBCOLLECTION
      // ============================================
      match /dismissedAnnouncements/{announcementId} {
        // Users can read/write their own dismissed announcements
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // ============================================
      // SEEN EVENTS SUBCOLLECTION
      // ============================================
      match /seenEvents/{eventId} {
        // Users can read/write their own seen events
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // ============================================
      // TICKETS SUBCOLLECTION (Admin Panel)
      // ============================================
      match /tickets/{ticketId} {
        // Admins can read/update/delete all tickets (for admin panel)
        allow read: if request.auth != null && isAdmin();
        allow update: if request.auth != null && isAdmin();
        allow delete: if request.auth != null && isAdmin();
      }
      
      // ============================================
      // OTHER USER SUBCOLLECTIONS
      // ============================================
      match /{subcollection=**} {
        // Users can read their own subcollections
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Write permissions handled by specific subcollection rules above
        allow write: if false;
      }
    }
    
    // ============================================
    // FEEDBACK COLLECTION (Top-Level)
    // ============================================
    match /feedback/{feedbackId} {
      // ✅ FIX: Authenticated users can create feedback
      // Users must include their userId in the document (must match auth.uid)
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.resource.data.userId == request.auth.uid;
      
      // ✅ FIX: Users can read their own feedback
      // Admins can read all feedback (for admin panel)
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && resource.data.userId == request.auth.uid));
      
      // Admins can update/delete all feedback (for admin panel)
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      // Users can read their own orders, admins can read all
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Users can create orders for themselves
      allow create: if request.auth != null;
      
      // CRITICAL FIX: Allow users to update their own order status for payment verification
      // Users can only update: status, verifiedAt, paymentId (for payment verification)
      // Users cannot update: userId, coins, amount, packageId, or other fields
      // Admins can update any order
      allow update: if request.auth != null 
        && resource.data != null
        && (isAdmin() 
            || (request.auth.uid == resource.data.userId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'paymentId'])
                && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) 
                    || request.resource.data.status == 'completed' 
                    || request.resource.data.status == 'failed' 
                    || request.resource.data.status == 'pending')));
      
      // Admins can delete orders
      allow delete: if isAdmin();
    }
    
    // ============================================
    // PAYMENTS COLLECTION
    // ============================================
    match /payments/{paymentId} {
      // Users can read their own payments, admins can read all
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Admins can create/update payments (for manual entries), Cloud Functions can also create/update
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WALLETS COLLECTION
    // ============================================
    match /wallets/{userId} {
      // Users can read their own wallet, admins can read all
      allow read: if request.auth != null 
        && (isAdmin() || request.auth.uid == userId);
      
      // Users can update their own wallet for sync with users collection (during coin deductions)
      // This ensures wallet balance stays in sync with users.uCoins
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ============================================
    // OTHER COLLECTIONS (Add as needed)
    // ============================================
    
    // Live streams collection
    match /live_streams/{streamId} {
      allow read: if true; // Public read for live streams
      allow create: if request.auth != null;
      allow update: if request.auth != null 
        && resource.data != null
        && request.auth.uid == resource.data.hostId;
      allow delete: if request.auth != null 
        && resource.data != null
        && request.auth.uid == resource.data.hostId;
      
      // Chat subcollection - messages in live streams
      match /chat/{messageId} {
        allow read: if true; // Public read for live chat messages
        allow create: if request.auth != null; // Authenticated users can send messages
        allow update: if false; // Messages cannot be updated
        // ⚠️ CRITICAL FIX: Only host or admin can delete messages
        // Check if user is the host of the parent stream or is an admin
        allow delete: if request.auth != null 
          && (isAdmin() 
              || (resource.data != null 
                  && resource.data.hostId == request.auth.uid)
              || (get(/databases/$(database)/documents/live_streams/$(streamId)).data.hostId == request.auth.uid));
      }
      
      // Viewers subcollection - track who is watching the stream
      match /viewers/{viewerId} {
        allow read: if true; // Public read for viewer list
        // Viewers can add/remove themselves from the viewers list
        allow create, delete: if request.auth != null && request.auth.uid == viewerId;
        allow update: if false; // Viewers cannot update their viewer document
      }
    }
    
    // Gifts collection
    match /gifts/{giftId} {
      allow read: if true; // Public read
      allow create: if false; // Only server/Cloud Functions
      allow update: if false;
      allow delete: if false;
    }
    
    // Earnings collection (for hosts)
    match /earnings/{userId} {
      // Users can read their own earnings, admins can read all
      allow read: if request.auth != null 
        && (isAdmin() || request.auth.uid == userId);
      // Allow authenticated users to update earnings when crediting hosts during calls
      // This is needed when callers deduct coins and credit hosts
      allow create, update: if request.auth != null;
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true; // Public read
      // Admins can create/update/delete announcements
      allow write: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if true; // Public read
      allow write: if isAdmin();
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Admins can read ALL chats (for admin panel)
      // Users can read chats where they are a participant
      // Also allow read for authenticated users (to check if chat exists before creating)
      allow read: if isAdmin() // Admin can read all
        || (request.auth != null 
            && (resource == null  // Document doesn't exist - allow check before create
                || resource.data == null  // Document exists but no data yet
                || request.auth.uid in resource.data.get('participants', []))); // User is participant
      
      // Users can create chats (they must be in the participants array)
      // Allow create if user is authenticated and included in participants
      // The app creates with: participants, lastMessage, lastMessageTime, unreadCount, createdAt, participantNames, participantImages
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.resource.data.get('participants', []).size() == 2
        && request.auth.uid in request.resource.data.get('participants', []);
      
      // Users can update chats where they are a participant, admins can update all
      // Allow updating lastMessage, lastMessageTime, unreadCount (including nested fields)
      allow update: if request.auth != null 
        && resource.data != null
        && (isAdmin() || request.auth.uid in resource.data.get('participants', []));
      
      // Admins can delete chats
      allow delete: if isAdmin();
      
      // Messages subcollection - participants can read/write their messages
      match /messages/{messageId} {
        // Helper function to check if user is a chat participant or admin
        function isChatParticipant() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return chatDoc != null 
            && chatDoc.data != null
            && (isAdmin() || request.auth.uid in chatDoc.data.get('participants', []));
        }
        
        // Participants can read messages in their chats, admins can read all
        // Allow read if user is authenticated and is a participant in the chat
        allow read: if request.auth != null 
          && (isAdmin() || isChatParticipant());
        
        // Participants can create messages if they're the sender, admins can create
        allow create: if request.auth != null 
          && request.resource.data != null
          && (isAdmin() 
              || (isChatParticipant() && request.auth.uid == request.resource.data.senderId));
        
        // Participants can update message read status, admins can update all
        allow update: if request.auth != null && (isAdmin() || isChatParticipant());
        
        // Admins can delete messages
        allow delete: if isAdmin();
      }
    }
    
    // Support chats collection
    match /supportChats/{chatId} {
      // Allow read if:
      // 1. User is admin (can read all for admin panel), OR
      // 2. User is authenticated AND (document doesn't exist OR user owns it)
      // Note: For non-existent documents (when checking before create), allow read
      // The create rule ensures users can only create their own chat
      allow read: if request.auth != null 
        && (isAdmin() 
            || resource == null  // Document doesn't exist - allow check before create
            || resource.data == null  // Document exists but has no data
            || resource.data.get('userId', '') == request.auth.uid);  // User owns the chat
      
      // Allow create if authenticated user is creating their own chat
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId;
      
      // Allow update if user owns the chat or is admin
      allow update: if request.auth != null 
        && resource.data != null
        && (request.auth.uid == resource.data.userId || isAdmin());
      
      allow delete: if false;
      
      // Messages subcollection - support chat messages
      match /messages/{messageId} {
        // Helper function to check support chat access
        function canAccessSupportChat() {
          let chatDoc = get(/databases/$(database)/documents/supportChats/$(chatId));
          return chatDoc != null 
            && chatDoc.data != null
            && (request.auth.uid == chatDoc.data.userId || isAdmin());
        }
        
        allow read: if request.auth != null && canAccessSupportChat();
        
        allow create: if request.auth != null 
          && request.resource.data != null
          && (request.auth.uid == request.resource.data.senderId || isAdmin());
        
        allow update: if request.auth != null && canAccessSupportChat();
        
        allow delete: if false; // Don't allow message deletion
      }
    }
    
    // Reseller chats collection (Admin Panel)
    match /resellerChats/{chatId} {
      // Admins can read/write all reseller chats (for admin panel)
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isAdmin();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && isAdmin();
        allow create: if request.auth != null && isAdmin();
        allow write: if request.auth != null && isAdmin();
      }
    }
    
    // Support tickets collection
    match /supportTickets/{ticketId} {
      // Users can read their own tickets, admins can read all
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Authenticated users can create tickets (must include their userId)
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId;
      
      // Only admins can update tickets (for status, adminResponse, assignedTo)
      allow update: if isAdmin();
      
      // Only admins can delete tickets
      allow delete: if isAdmin();
    }
    
    // Tickets collection (Fallback for Dashboard)
    match /tickets/{ticketId} {
      // Admins can read tickets (for admin panel fallback)
      allow read: if request.auth != null && isAdmin();
    }
    
    // Withdrawal requests collection
    match /withdrawal_requests/{requestId} {
      // Admins can read ALL withdrawal requests (for admin panel queries)
      // Users can read their own withdrawal requests
      allow read: if request.auth != null 
        && (isAdmin()  // Admin can read all - checked first for collection queries
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Users can create their own withdrawal requests
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId;
      
      // Only admins can update (approve/reject payments)
      allow update: if request.auth != null && isAdmin();
      
      // No one can delete
      allow delete: if false;
    }
    
    // Transactions collection (top-level for admin panel queries)
    match /transactions/{transactionId} {
      // Admins can read all transactions (for admin panel)
      // Note: This is separate from users/{userId}/transactions subcollection
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Call transactions collection
    match /callTransactions/{transactionId} {
      // ⚠️ CRITICAL FIX: Restrict read access to only admins or users involved in the transaction
      // Users can only read their own call transactions (where they are caller or host)
      // Admins can read all transactions
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null 
                && (request.auth.uid == resource.data.callerId 
                    || request.auth.uid == resource.data.hostId)));
      // Users can create call transactions when they make calls (for coin deduction tracking)
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.callerId;
      // Admins can update/delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Call requests collection
    match /callRequests/{requestId} {
      // Callers can create call requests (viewers calling hosts OR users calling users)
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.callerId;
      
      // Hosts can read their incoming call requests (live stream calls - by hostId)
      // Receivers can read their incoming call requests (chat calls - by receiverId)
      // Callers can read their own call requests (by callerId)
      allow read: if request.auth != null 
        && (resource.data != null && (
          resource.data.hostId == request.auth.uid ||  // Live stream calls (host)
          resource.data.receiverId == request.auth.uid ||  // Chat calls (receiver)
          resource.data.callerId == request.auth.uid  // All calls (caller)
        ));
      
      // Hosts can update call requests (accept/reject live stream calls)
      // Receivers can update call requests (accept/reject chat calls)
      // Callers can update their own call requests (cancel)
      allow update: if request.auth != null 
        && resource.data != null
        && (resource.data.hostId == request.auth.uid ||  // Live stream calls (host)
            resource.data.receiverId == request.auth.uid ||  // Chat calls (receiver)
            resource.data.callerId == request.auth.uid);  // All calls (caller)
      
      // Only server/Cloud Functions can delete
      allow delete: if false;
    }
    
    // Notification requests collection
    match /notificationRequests/{requestId} {
      // Users can create notification requests (for sending push notifications)
      // Cloud Functions will process these requests
      allow create: if request.auth != null;
      
      // Only server/Cloud Functions can read and update
      allow read: if false; // Only server
      allow update: if false; // Only server/Cloud Functions
      allow delete: if false; // Only server/Cloud Functions
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if isAdmin(); // Only admin
      allow create: if request.auth != null;
      allow update: if isAdmin(); // Only admin
      allow delete: if isAdmin(); // Only admin
    }
    
    // Team messages collection (Chamakz Team broadcast messages)
    match /team_messages/{messageId} {
      // Admins can read all team messages (for admin panel)
      // App users can read team messages (public read)
      allow read: if true; // Public read for app users, admin panel can also read
      
      // Allow authenticated users to create team messages (for admin panel)
      // TODO: Once admin panel authentication is properly set up, change to: allow create: if isAdmin();
      allow create: if request.auth != null;
      
      // Users can update readBy field (mark as read), admins can update all fields
      // ✅ FIX: Allow users to update their own readBy entry (add or update to true)
      // This allows batch updates where user adds their own entry without affecting others
      allow update: if request.auth != null 
        && (isAdmin() 
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) 
                && request.resource.data.readBy[request.auth.uid] == true));
      
      // Only admins can delete team messages
      allow delete: if isAdmin();
    }
    
    // ============================================
    // BANNERS COLLECTION
    // ============================================
    match /banners/{bannerId} {
      // Admin panel: Admins can read ALL banners (for management)
      // App users: Any authenticated user can read banners (app filters by isActive client-side)
      // Public read allowed - app filters inactive banners in code
      allow read: if request.auth != null;
      
      // Allow analytics tracking (impressions/clicks updates)
      // Authenticated users can update only impressions, clicks, and updatedAt fields
      // Admins can update all fields
      allow update: if request.auth != null
                   && (isAdmin() // Admin can update all fields
                       || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['impressions', 'clicks', 'updatedAt'])); // App can update only analytics
      
      // Admin panel: Admins can create/update/delete banners
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // SETTINGS COLLECTION (Admin Panel)
    // ============================================
    match /settings/{settingId} {
      // Admins can read/update settings (for admin panel)
      allow read: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // HOST APPLICATIONS COLLECTION
    // ============================================
    match /host_applications/{applicationId} {
      // Users can read their own applications (to check status)
      // Admins can read all applications (for admin panel)
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Authenticated users can create their own applications
      // Must include their userId in the document
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'; // Can only create with pending status
      
      // Only admins can update applications (approve/reject)
      allow update: if request.auth != null && isAdmin();
      
      // Only admins can delete applications
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // SHARE TRACKING COLLECTION
    // ============================================
    match /share_tracking/{trackingId} {
      // Users can read their own share tracking records
      // Admins can read all records
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Authenticated users can create their own share tracking records
      // Must include their userId in the document
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.shareType in ['url', 'qr_code']
        && request.resource.data.appLink != null;
      
      // Users can update their own share tracking records (for reward tracking)
      // Admins can update all records
      allow update: if request.auth != null 
        && resource.data != null
        && (isAdmin() 
            || (request.auth.uid == resource.data.userId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardGiven'])));
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ============================================
    // REWARD TRANSACTIONS COLLECTION
    // ============================================
    match /reward_transactions/{transactionId} {
      // Users can read their own reward transactions
      // Admins can read all transactions
      allow read: if request.auth != null 
        && (isAdmin() 
            || (resource.data != null && request.auth.uid == resource.data.userId));
      
      // Only server/Cloud Functions can create reward transactions
      // Users cannot create directly (created by reward service)
      // For now, allow authenticated users to create (will be restricted later)
      allow create: if request.auth != null 
        && request.resource.data != null
        && request.auth.uid == request.resource.data.userId;
      
      // Only admins can update/delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Default: Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
