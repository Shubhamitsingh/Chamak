rules_version = '2';
// Firebase Storage Security Rules
// Allow authenticated users to upload/read their own profile pictures and cover photos
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: profile_pictures/{userId}/profile_{userId}.jpg
    match /profile_pictures/{userId}/{fileName} {
      // Allow read: anyone can view profile pictures
      allow read: if true;
      // Allow write: only the owner can upload/update their profile picture
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cover photos: cover_photos/{userId}/cover_{userId}_{index}.jpg
    match /cover_photos/{userId}/{fileName} {
      // Allow read: anyone can view cover photos
      allow read: if true;
      // Allow write: only the owner can upload/update their cover photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Chat images: chat_images/{userId}/chat_{userId}_{timestamp}.jpg
    match /chat_images/{userId}/{fileName} {
      // Allow read: anyone can view chat images
      allow read: if true;
      // Allow write: only authenticated users can upload chat images
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admin avatars: admin_avatars/{userId}/{fileName}
    match /admin_avatars/{userId}/{fileName} {
      // Allow read: anyone can view admin avatars
      allow read: if true;
      // Allow write: only authenticated users can upload to their own admin avatar folder
      // Note: Admin panel access is controlled by Firestore rules, so this is secure
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Banner images: banners/{fileName} (flat structure - used by admin panel)
    match /banners/{fileName} {
      // Allow read: anyone can view banner images (public URLs)
      allow read: if true;
      // Allow write: authenticated users (admins) can upload banner images
      // Note: Admin check is done via Firestore admins collection
      allow write: if request.auth != null;
      // For production, use admin check:
      // allow write: if request.auth != null
      //            && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Banner images: banners/{bannerId}/{fileName} (nested structure - legacy)
    match /banners/{bannerId}/{fileName} {
      // Allow read: anyone can view banner images (public URLs)
      allow read: if true;
      // Allow write: authenticated users (admins) can upload banner images
      allow write: if request.auth != null;
    }
    
    // Team message images: team_messages/{fileName}
    match /team_messages/{fileName} {
      // Allow read: anyone can view team message images (public URLs)
      allow read: if true;
      // Allow write: authenticated users (admins) can upload team message images
      // Note: Admin check is done via Firestore admins collection
      allow write: if request.auth != null;
      // For production, use admin check:
      // allow write: if request.auth != null
      //            && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

