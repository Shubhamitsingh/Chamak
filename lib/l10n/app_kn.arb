  "faqUpdateProfileAnswer": "ಪ್ರೊಫೈಲ್ ಟ್ಯಾಬ್‌ಗೆ ಹೋಗಿ, ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಚಿತ್ರದಲ್ಲಿ ಸಂಪಾದನೆ ಐಕಾನ್‌ನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ನೀವು ನಿಮ್ಮ ಹೆಸರು, ವಯಸ್ಸು, ಲಿಂಗ, ಭಾಷೆ, ಸ್ಥಳ, ಬಯೋ ಅನ್ನು ನವೀಕರಿಸಬಹುದು ಮತ್ತು ಕವರ್ ಫೋಟೋಗಳನ್ನು ಸೇರಿಸಬಹುದು.",
  "faqRechargeWallet": "ನನ್ನ ವಾಲೆಟ್‌ನ್ನು ಹೇಗೆ ರೀಚಾರ್ಜ್ ಮಾಡುವುದು?",
  "faqRechargeWalletAnswer": "ಪ್ರೊಫೈಲ್ ಮೆನುವಿನಿಂದ ವಾಲೆಟ್ ತೆರೆಯಿರಿ, ಫ್ಲಾಟ್ ರೀಚಾರ್ಜ್ ಅಥವಾ ರೀಸೆಲ್ಲರ್ ಆಯ್ಕೆಗಳ ನಡುವೆ ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಪ್ಯಾಕೇಜ್ ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು Google Play ಮೂಲಕ ಪಾವತಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
  "faqSendMessages": "ನಾನು ಸಂದೇಶಗಳನ್ನು ಹೇಗೆ ಕಳುಹಿಸುವುದು?",
  "faqSendMessagesAnswer": "ಬಳಕೆದಾರರನ್ನು ಹುಡುಕಿ, ಅವರ ಪ್ರೊಫೈಲ್ ತೆರೆಯಿರಿ ಮತ್ತು ಸಂದೇಶ ಬಟನ್‌ನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ನೀವು ನಿಮ್ಮ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿರುವ ಸಂದೇಶಗಳು ಮೆನುವಿನಿಂದ ನಿಮ್ಮ ಎಲ್ಲಾ ಚಾಟ್‌ಗಳಿಗೆ ಪ್ರವೇಶಿಸಬಹುದು.",
  "faqFollowers": "ಅನುಯಾಯಿಗಳು ಮತ್ತು ಅನುಸರಿಸುವುದು ಏನು?",
  "faqFollowersAnswer": "ಅನುಯಾಯಿಗಳು ನಿಮ್ಮನ್ನು ಅನುಸರಿಸುವ ಬಳಕೆದಾರರು. ಅನುಸರಿಸುವುದು ನೀವು ಅನುಸರಿಸುವ ಬಳಕೆದಾರರನ್ನು ತೋರಿಸುತ್ತದೆ. ನೀವು ಇವುಗಳನ್ನು ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಮತ್ತು ಇತರ ಬಳಕೆದಾರರ ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ನೋಡಬಹುದು.",
  "faqLevelSystem": "ಮಟ್ಟದ ವ್ಯವಸ್ಥೆ ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ?",
  "faqLevelSystemAnswer": "ನೀವು ಅಪ್ಲಿಕೇಶನ್ ಬಳಸಿದಂತೆ ನಿಮ್ಮ ಮಟ್ಟವು ಹೆಚ್ಚಾಗುತ್ತದೆ. ಹೆಚ್ಚಿನ ಮಟ್ಟಗಳು ವಿಶೇಷ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಬ್ಯಾಜ್‌ಗಳನ್ನು ಅನ್ಲಾಕ್ ಮಾಡುತ್ತವೆ. ವಿವರಗಳನ್ನು ನೋಡಲು ನಿಮ್ಮ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಮಟ್ಟವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ.",
  "faqChangePhone": "ನನ್ನ ಫೋನ್ ಸಂಖ್ಯೆಯನ್ನು ಹೇಗೆ ಬದಲಾಯಿಸುವುದು?",
  "faqChangePhoneAnswer": "ಪ್ರೊಫೈಲ್ → ಖಾತೆ ಮತ್ತು ಭದ್ರತೆ → ಫೋನ್ ಸಂಖ್ಯೆಯನ್ನು ನವೀಕರಿಸಿ. ನಿಮ್ಮ ಹೊಸ ಸಂಖ್ಯೆಯನ್ನು ನಮೂದಿಸಿ ಮತ್ತು OTP ಮೂಲಕ ಪರಿಶೀಲಿಸಿ.",
  "faqWithdrawEarnings": "ನನ್ನ ಗಳಿಕೆಯನ್ನು ಹೇಗೆ ಹಿಂಪಡೆಯುವುದು?",
  "faqWithdrawEarningsAnswer": "ಪ್ರೊಫೈಲ್ ಮೆನುವಿನಿಂದ ನನ್ನ ಗಳಿಕೆ ತೆರೆಯಿರಿ. ಹಿಂಪಡೆಯುವಿಕೆ ಮೊತ್ತವನ್ನು ನಮೂದಿಸಿ, ನಿಮ್ಮ UPI ID ಅಥವಾ ಬ್ಯಾಂಕ್ ವಿವರಗಳನ್ನು ಒದಗಿಸಿ ಮತ್ತು ಸಲ್ಲಿಸಿ. ಕನಿಷ್ಠ ಹಿಂಪಡೆಯುವಿಕೆ ₹50.",
  "faqDeleteAccount": "ನನ್ನ ಖಾತೆಯನ್ನು ಹೇಗೆ ಅಳಿಸುವುದು?",
  "faqDeleteAccountAnswer": "ಪ್ರೊಫೈಲ್ → ಖಾತೆ ಮತ್ತು ಭದ್ರತೆ → ಖಾತೆಯನ್ನು ಅಳಿಸಿ. ದೃಢೀಕರಿಸಲು DELETE ಟೈಪ್ ಮಾಡಿ. ಈ ಕ್ರಿಯೆಯು ಶಾಶ್ವತವಾಗಿದೆ ಮತ್ತು ರದ್ದುಮಾಡಲಾಗುವುದಿಲ್ಲ.",
  "faqEnableNotifications": "ಅಧಿಸೂಚನೆಗಳನ್ನು ಹೇಗೆ ಸಕ್ರಿಯಗೊಳಿಸುವುದು?",
  "faqEnableNotificationsAnswer": "ಪ್ರೊಫೈಲ್ → ಸೆಟ್ಟಿಂಗ್ಗಳು → ಅಧಿಸೂಚನೆ ಸೆಟ್ಟಿಂಗ್ಗಳು. ನೀವು ಸ್ವೀಕರಿಸಲು ಬಯಸುವ ಅಧಿಸೂಚನೆಗಳ ಪ್ರಕಾರಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.",
  "faqAppNotWorking": "ಅಪ್ಲಿಕೇಶನ್ ಸರಿಯಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ, ಏನು ಮಾಡಬೇಕು?",
  "faqAppNotWorkingAnswer": "ಈ ಹಂತಗಳನ್ನು ಪ್ರಯತ್ನಿಸಿ: 1) ಅಪ್ಲಿಕೇಶನ್ ಕ್ಯಾಶ್ ಅನ್ನು ತೆರವುಗೊಳಿಸಿ, 2) ಅತ್ಯಾಧುನಿಕ ಆವೃತ್ತಿಗೆ ನವೀಕರಿಸಿ, 3) ನಿಮ್ಮ ಸಾಧನವನ್ನು ಪುನರಾರಂಭಿಸಿ, 4) ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ, ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ.",
